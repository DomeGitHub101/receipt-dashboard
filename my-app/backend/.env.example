# Defaults to SQLite locally. Docker Compose supplies PostgreSQL.
# DATABASE_URL=postgresql+asyncpg://slipsnap:slipsnap@db:5432/slipsnap
# Generate a random secret before deployment; local development generates .dev-secret.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
ALLOWED_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
OCR_LANGUAGES=eng+tha
