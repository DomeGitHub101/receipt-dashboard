# Defaults to SQLite locally. Docker Compose supplies PostgreSQL.
# DATABASE_URL=postgresql+asyncpg://slipsnap:slipsnap@db:5432/slipsnap
# Generate a random secret before deployment; local development generates .dev-secret.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
ALLOWED_ORIGIN=http://localhost:5173
# Optional extra frontend origins, for example a phone on the local network:
ADDITIONAL_ORIGINS=[]
COOKIE_SECURE=false
OCR_LANGUAGES=eng+tha

# Email links use this trusted frontend URL, never the request Host header.
PUBLIC_URL=http://localhost:5173
# Gmail example: turn on 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords, and use it below (not your normal password).
# SMTP_HOST=smtp.gmail.com
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=abcdefghijklmnop
# SMTP_FROM=SlipSnap <you@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
# Set true before opening registration to the public; configure SMTP first.
REQUIRE_VERIFIED_EMAIL=false

# Sign in with Google: create an OAuth client ID (type "Web application") in Google Cloud Console
# with Authorized JavaScript origins http://localhost:5173 and http://127.0.0.1:5173. Leave empty to hide the button.
GOOGLE_CLIENT_ID=
